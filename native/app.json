{
  "expo": {
    "name": "Roomie",
    "slug": "roomie",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "roomie",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.pemaghising.roomie",
      "supportsTablet": false
    },
    "android": {
      "package": "com.pemaghising.roomie",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFC",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "backgroundImage": "./assets/brand/android-background.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roomie uses your photos so you can pick a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/android-monochrome.png",
          "color": "#7A5FD6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6FC",
          "image": "./assets/brand/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Roomie uses the camera to scan your home’s QR code.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e154203c-23cd-4717-9ca1-2f884fffbdd5"
      }
    },
    "owner": "pemaghising"
  }
}
