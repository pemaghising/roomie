{
  "expo": {
    "name": "Roomie",
    "slug": "roomie",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "roomie",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.pemaghising.roomie",
      "supportsTablet": false
    },
    "android": {
      "package": "com.pemaghising.roomie",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFFC",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "backgroundImage": "./assets/brand/android-background.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roomie uses your photos so you can pick a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/android-monochrome.png",
          "color": "#7A5FD6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6FC",
          "image": "./assets/brand/splash.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
