{
  "name": "roomie",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Roomie: fair chores and a shared pantry for roommates. Expo app, Supabase backend, marketing site and UX case study in one repo.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "mobile": "npm --prefix apps/mobile start",
    "site": "npm --prefix apps/site run dev",
    "case-study": "npm --prefix apps/case-study run dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "supabase": "^2.119.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
